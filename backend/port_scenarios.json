      "description": "A small fishing port with limited budget requiring basic perimeter surveillance and vessel monitoring during daytime operations.",
      "environment": {
        "location_type": "coastal",
        "wind_exposure": "moderate",
        "avg_wind_speed_kmh": 25,
        "salt_spray": true,
        "operating_hours": "daytime_only",
        "area_km2": 0.5
      },
      "mission": {
        "primary": "perimeter_surveillance",
        "secondary": ["vessel_monitoring", "intruder_detection"],
        "flight_frequency": "daily",
        "avg_mission_duration_min": 30
      },
      "budget": {
